{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bootstrap-sha": "4382ecc7ae79beebf8eb5d171d255f22b89778ca",
  "include-component-in-tag": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Fonctionnalités"
    },
    {
      "type": "fix",
      "section": "Corrections"
    },
    {
      "type": "perf",
      "section": "Performances"
    },
    {
      "type": "refactor",
      "section": "Refonte interne"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Construction et dépendances"
    },
    {
      "type": "ci",
      "section": "Intégration continue",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Divers",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "sillon",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/api/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}

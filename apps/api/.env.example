# Base de données (l'utilisateur ne doit être ni superutilisateur ni BYPASSRLS)
DATABASE_URL="postgresql://sillon:sillon@localhost:5432/sillon_dev?schema=public"
# Base utilisée par les tests d'intégration (vidée à chaque exécution)
TEST_DATABASE_URL="postgresql://sillon:sillon@localhost:5432/sillon_test?schema=public"

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Secret de signature des cookies de session (obligatoire hors développement)
SESSION_SECRET="changez-moi-32-caracteres-minimum-svp"
# Origines autorisées pour le front (séparées par des virgules)
CORS_ORIGINS="http://localhost:5173"
# Cookies en HTTPS uniquement (true en production)
COOKIE_SECURE=false

# Serveur SMTP des courriels transactionnels (invitation, confirmation, mot de passe
# oublié). Absent, les messages s'affichent dans la console : de quoi dérouler un
# parcours en développement sans rien configurer.
# SMTP_URL="smtps://utilisateur:motdepasse@smtp.example.org:465"
MAIL_FROM="Sillon <ne-pas-repondre@localhost>"
# Adresse publique de l'interface, pour fabriquer les liens des courriels
APP_URL="http://localhost:5173"
# Validité des liens de confirmation et de réinitialisation, en heures
TOKEN_HOURS=24

# File de fond (BullMQ). Absent, les courriels partent dans la requête qui les déclenche :
# pratique en développement, à éviter en production. Avec lui, lancer aussi le worker :
# npm run dev:worker -w @sillon/api
# REDIS_URL="redis://localhost:6379"
# Courriels traités de front par le worker
MAIL_CONCURRENCY=4
# Photos. Sans seau S3, elles vont dans un dossier local.
UPLOAD_DIR="uploads"
# Stockage objet compatible S3, hébergé dans l'UE (Scaleway, OVH, Hetzner…).
# S3_BUCKET="sillon-photos"
# S3_ENDPOINT="https://s3.fr-par.scw.cloud"
# S3_REGION="fr-par"
# S3_ACCESS_KEY_ID="…"
# S3_SECRET_ACCESS_KEY="…"
# Préfixe des clés, pour partager un seau entre plusieurs déploiements
# S3_PREFIX="production"
# Forme des URL : « chemin » (serveur/seau/clé). MinIO et plusieurs services
# européens ne servent que celle-là ; mettre false pour la forme sous-domaine.
S3_FORCE_PATH_STYLE=true
